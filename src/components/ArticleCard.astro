---
import { Picture } from "astro:assets";
import { approvedCardImage, type EditorialCard } from "../lib/editorialMedia";

type Props = {
  card: EditorialCard;
  title: string;
  updated: Date;
  readingMinutes: number;
};

const { card, title, updated, readingMinutes } = Astro.props;
const media = approvedCardImage(card);
const href = `/${card.slug}/`;
const updatedIso = updated.toISOString().slice(0, 10);
const updatedLabel = updated.toLocaleDateString("en-US", {
  month: "short",
  day: "numeric",
  year: "numeric",
  timeZone: "UTC"
});
---

<article class="story">
  <div class="story-media">
    {media && (
      <Picture
        src={media.image}
        formats={["avif", "webp"]}
        fallbackFormat="jpg"
        widths={[480, 640, 800, 1200]}
        sizes="(max-width: 620px) calc(100vw - 32px), (max-width: 1100px) 45vw, 290px"
        alt=""
        loading="lazy"
        decoding="async"
        style={media.focus ? `object-position: ${media.focus}` : undefined}
      />
    )}
  </div>
  <div class="story-body">
    <p class="story-kicker">{card.kicker}</p>
    <h3 class="story-title"><a href={href}>{title}</a></h3>
    <p class="story-decision">{card.decision}</p>
    <p class="story-meta">
      <span>Updated <time datetime={updatedIso}>{updatedLabel}</time></span>
      <span>{readingMinutes} min read</span>
      <span class="story-arrow" aria-hidden="true">→</span>
    </p>
  </div>
</article>
