---
import {
  getAffiliateHref,
  getAffiliateLabel,
  getAffiliateRel,
  getLinkKind,
  isAffiliateLink,
  type ProductKey
} from "../lib/affiliateLinks";

type Props = {
  product: ProductKey;
  article: string;
  placement: string;
  note?: string;
  variant?: "inline" | "prominent";
};

const { product, article, placement, note, variant = "prominent" } = Astro.props;
const href = getAffiliateHref(product);
const affiliate = isAffiliateLink(product);
// A plain official-site link is not an affiliate click. Emitting one event
// name for both would inflate the affiliate_click count that the funnel
// review reads, so the event name follows the actual link kind.
const eventName = affiliate ? "affiliate_click" : "outbound_click";
---

<div class:list={["cta", variant]}>
  <div class="cta-copy">
    <p class="cta-kind" data-affiliate={affiliate}>{getLinkKind(product)}</p>
    <strong>{getAffiliateLabel(product)}</strong>
    {note && <p class="cta-note">{note}</p>}
  </div>
  <a
    class="button"
    href={href}
    rel={getAffiliateRel(product)}
    target="_blank"
    data-event={eventName}
    data-product={product}
    data-article={article}
    data-placement={placement}
  >
    {getAffiliateLabel(product)}
  </a>
</div>
