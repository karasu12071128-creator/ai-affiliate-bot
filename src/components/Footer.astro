---
import { site, operator } from "../site";
---

<footer class="site-footer">
  <div class="colophon">
    <div>
      <p class="colophon-operator">
        {site.name} is published by <a href={operator.url} rel="noopener">{operator.name}</a>, an
        independent one-person studio based in {operator.location}. Editorial contact:
        <a href={`mailto:${operator.email}`}>{operator.email}</a>.
      </p>
      <p>
        Some outbound links are affiliate links and are labeled on the page. Links that are not
        affiliate links earn us nothing.
      </p>
      <p>&copy; 2026 {operator.name}.</p>
    </div>
    <nav aria-label="Footer navigation">
      <a href="/how-we-test/">How we test</a>
      <a href="/editorial-methodology/">Editorial methodology</a>
      <a href="/affiliate-disclosure/">Affiliate disclosure</a>
      <a href="/privacy-policy/">Privacy policy</a>
      <a href="/contact/">Contact</a>
    </nav>
  </div>
</footer>
