---
import { site, operator } from "../site";
---

<footer class="site-footer">
  <div class="colophon">
    <div>
      <p class="colophon-brand">{site.name}</p>
      <p class="colophon-line">Choose by fit, not hype.</p>
      <p>
        Published by <a href={operator.url} rel="noopener">{operator.name}</a>. Editorial contact:
        <a href={`mailto:${operator.email}`}>{operator.email}</a>.
      </p>
      <p>
        Some outbound links are affiliate links and are labeled on the page. Links that are not
        affiliate links earn us nothing.
      </p>
      <p>&copy; 2026 {operator.name}.</p>
    </div>
    <nav aria-label="Footer navigation">
      <a href="/about/">About</a>
      <a href="/how-we-test/">How We Review</a>
      <a href="/editorial-methodology/">Editorial Methodology</a>
      <a href="/affiliate-disclosure/">How We Make Money</a>
      <a href="/affiliate-disclosure/">Affiliate Disclosure</a>
      <a href="/contact/">Contact</a>
      <a href="/privacy-policy/">Privacy</a>
    </nav>
  </div>
</footer>
