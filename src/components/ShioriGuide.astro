---
import { Picture } from "astro:assets";
import { activeShioriMascot } from "../lib/shiori";

type Props = {
  /** What Shiori says. Short: two to four words. */
  message: string;
  class?: string;
};

const { message, class: className } = Astro.props;
const mascot = activeShioriMascot();
---

{mascot && (
  <div class:list={["shiori", className]}>
    <p class="shiori-bubble">{message}</p>
    <span class="shiori-figure">
      <Picture
        src={mascot.image}
        formats={["avif", "webp"]}
        fallbackFormat="png"
        widths={[120, 240]}
        sizes="120px"
        alt=""
        loading="lazy"
        decoding="async"
      />
    </span>
  </div>
)}
