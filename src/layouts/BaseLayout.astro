---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { site, operator } from "../site";
import "../styles/global.css";

type Props = {
  title?: string;
  description?: string;
  canonicalPath?: string;
};

const title = Astro.props.title ? `${Astro.props.title} | ${site.name}` : site.name;
const description = Astro.props.description ?? site.description;
const canonical = new URL(Astro.props.canonicalPath ?? Astro.url.pathname, site.url).toString();

// Publisher identity, stated once in structured data. A named operator with a
// working contact route is the baseline an affiliate program reviewer checks.
const publisherJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: site.name,
  url: site.url,
  description: site.description,
  publisher: {
    "@type": "Organization",
    name: operator.name,
    url: operator.url,
    email: operator.email
  }
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script defer src="/analytics.js"></script>
    <script type="application/ld+json" set:html={JSON.stringify(publisherJsonLd)} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
