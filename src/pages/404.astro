---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found" description="That page does not exist on Creator Growth Tools.">
  <section class="page">
    <p class="eyebrow">404</p>
    <h1>That page does not exist.</h1>
    <p class="dek">
      The link may be out of date, or the page may have been renamed. The article index is the
      quickest way to pick things back up.
    </p>
    <p><a class="button" href="/articles/">Browse all articles</a></p>
    <p class="notice">
      If a link on this site sent you here, we would like to fix it — see
      <a href="/contact/">contact</a>.
    </p>
  </section>
</BaseLayout>
