---
import BaseLayout from "../layouts/BaseLayout.astro";
import { affiliateTargets, hasAffiliateProgram, type ProductKey } from "../lib/affiliateLinks";
import { operator } from "../site";

// Material connections, rendered from the affiliate registry so this page
// cannot drift from what the site's links actually do. Readers see which
// brands can pay us; application states (pending, declined) and link
// plumbing stay in the registry and data/affiliate-programs.yaml.
const earningBrands = (Object.keys(affiliateTargets) as ProductKey[])
  .filter((key) => hasAffiliateProgram(key))
  .map((key) => affiliateTargets[key].product);

const brandList =
  earningBrands.length <= 1
    ? earningBrands.join("")
    : `${earningBrands.slice(0, -1).join(", ")} and ${earningBrands.at(-1)}`;
---

<BaseLayout
  title="How We Make Money"
  description="How Creator Growth Tools is funded, which brands can pay us a commission, and what that commission does not buy."
>
  <section class="page">
    <p class="eyebrow">Affiliate disclosure</p>
    <h1>How we make money.</h1>
    <p class="dek">
      We may earn a commission if you buy through some links on this site, at no extra cost to
      you. That is how the site is funded. It does not decide which tools we cover or recommend.
    </p>

    <div class="prose">
      <h2>Who can pay us</h2>
      {earningBrands.length > 0 ? (
        <p>
          We currently have affiliate relationships with {brandList}. If you sign up through one of
          our links to these products, we may be paid a commission.
        </p>
      ) : (
        <p>We have no affiliate relationships at the moment.</p>
      )}
      <p>
        Every other tool we mention links straight to its own website, and those links earn us
        nothing.
      </p>

      <h2>How to tell which links pay us</h2>
      <p>
        Product buttons are labeled <strong>Affiliate link</strong> or <strong>Official site</strong>
        where you click them, and every article that contains an affiliate link says so at the top.
        Links to a vendor inside an article's text go to the vendor's own site, not through a
        referral link.
      </p>

      <h2>What commission does not buy</h2>
      <p>
        Commission plays no part in whether a tool is included, where it ranks, or what verdict it
        gets, and placement cannot be bought. Several of our guides recommend tools we earn nothing
        from when they fit the reader better. See <a href="/how-we-test/">how we review</a> and our
        <a href="/editorial-methodology/">editorial policy</a>.
      </p>

      <h2>Prices and terms change</h2>
      <p>
        Pricing and plan details change without notice. Check the vendor's own site before you buy.
        If you spot something out of date, tell us at
        <a href={`mailto:${operator.email}`}>{operator.email}</a>.
      </p>
    </div>
  </section>
</BaseLayout>
