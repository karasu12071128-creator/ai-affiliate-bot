---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import EvidenceMark from "../../components/EvidenceMark.astro";
import { getCategory, categoryPath } from "../../lib/categories";

const articles = (await getCollection("articles")).sort(
  (a, b) => b.data.updatedDate.valueOf() - a.data.updatedDate.valueOf()
);
---

<BaseLayout
  title="Articles"
  description="Every comparison, review, and guide published by Creator Growth Tools, with the date its facts were last verified."
>
  <section class="page">
    <p class="eyebrow">Articles</p>
    <h1>Everything we have published.</h1>
    <p class="dek">
      A deliberately small library. Every entry carries the evidence it was built on and the date
      its facts were last checked.
    </p>
    <div class="guide-search" id="search">
      <label for="guide-search-input">Search guides</label>
      <input
        id="guide-search-input"
        type="search"
        placeholder="Try beehiiv, Substack, voice…"
        autocomplete="off"
        disabled
      />
      <p class="guide-search-status" role="status" aria-live="polite"></p>
    </div>
    <ol class="entries" id="guide-list">
      {articles.map((article, index) => (
        <li class="entry" data-search={`${article.data.title} ${article.data.description} ${getCategory(article.data.category).name}`.toLowerCase()}>
          <span class="entry-index" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
          <div>
            <p class="eyebrow">
              <a href={categoryPath(article.data.category)}>
                {getCategory(article.data.category).name}
              </a>
            </p>
            <h2><a href={`/${article.slug}/`}>{article.data.title}</a></h2>
            <p>{article.data.description}</p>
            <p class="entry-meta">
              <EvidenceMark grade={article.data.evidence} />
              <span>Updated {article.data.updatedDate.toISOString().slice(0, 10)}</span>
              <span>Last verified {article.data.lastVerifiedDate}</span>
            </p>
          </div>
        </li>
      ))}
    </ol>
  </section>
</BaseLayout>

<script is:inline>
  // Client-side filter over the guides already on this page. No index file,
  // no request, no dependency. Without JS the input stays disabled and the
  // full list is shown.
  (function () {
    var input = document.getElementById("guide-search-input");
    var status = document.querySelector(".guide-search-status");
    var items = Array.prototype.slice.call(document.querySelectorAll("#guide-list > li"));
    if (!input || !status) return;
    input.disabled = false;
    if (location.hash === "#search") input.focus({ preventScroll: true });
    input.addEventListener("input", function () {
      var terms = input.value.toLowerCase().split(/\s+/).filter(Boolean);
      var shown = 0;
      items.forEach(function (item) {
        var text = item.getAttribute("data-search") || "";
        var match = terms.every(function (term) { return text.indexOf(term) !== -1; });
        item.hidden = !match;
        if (match) shown += 1;
      });
      status.textContent = terms.length ? shown + " of " + items.length + " guides" : "";
    });
  })();
</script>
