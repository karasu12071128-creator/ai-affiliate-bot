---
import BaseLayout from "../layouts/BaseLayout.astro";
import EvidenceMark from "../components/EvidenceMark.astro";
import { evidenceGrades, getEvidenceMeaning } from "../lib/evidence";
import { operator } from "../site";

// The axes we score a tool against. These are the questions a creator is
// actually deciding on, in the order the decision usually happens.
const criteria = [
  {
    axis: "Who it is for",
    detail:
      "The workflow the tool assumes. A platform built for a paid newsletter and one built for a course funnel are not competitors, and calling them one is the most common mistake in this category."
  },
  {
    axis: "Who should not use it",
    detail:
      "Each review names the situations where the tool is a poor fit."
  },
  {
    axis: "Real cost at your size",
    detail:
      "Headline pricing plus the thresholds that change it — subscriber tiers, send limits, seats, and what moves you up a plan. Quoted with the date we checked."
  },
  {
    axis: "Free plan and trial",
    detail:
      "Whether you can evaluate it without paying, and what the free tier withholds."
  },
  {
    axis: "Learning curve",
    detail: "How long before the tool is doing useful work, not how many features exist."
  },
  {
    axis: "Output and export",
    detail:
      "What you can take with you: list export, content export, file formats, and whether leaving is realistic."
  },
  {
    axis: "Limits and hard edges",
    detail:
      "The constraints people hit after committing — automation ceilings, deliverability handling, plan gates, support response."
  },
  {
    axis: "Commercial terms",
    detail:
      "Usage rights, and for AI tooling, whether output is licensed for commercial and monetized use. This decides whether the tool is usable at all."
  },
  {
    axis: "Fit with a small operation",
    detail:
      "Whether one person can run it without hiring around it — the constraint most reviews written for teams ignore."
  }
];

const rules = [
  "A tool is compared against the alternative a reader is realistically weighing, not against a strawman.",
  "Pricing is read from the vendor's own pricing page and dated. Where a plan gate is unclear, we say it is unclear.",
  "Repeated patterns across verified review marketplaces count as evidence. A single forum comment does not.",
  "An affiliate relationship never moves a tool up. Where we have no affiliate link for a better-fitting tool, we still recommend it.",
  "When we get something wrong, the page is corrected and the verification date moves. Nothing is quietly deleted."
];
---

<BaseLayout
  title="How we test"
  description="The criteria Creator Growth Tools evaluates tools against, and the evidence grade shown on every article."
>
  <section class="page">
    <p class="eyebrow">Method</p>
    <h1>How we evaluate a tool.</h1>
    <p class="dek">
      This page explains how we assess a tool, what our evidence grades mean, and the limits we
      work within.
    </p>

    <div class="prose">
      <h2>Evidence grades</h2>
      <p>
        Every article carries one of these marks at the top. It states what the article's claims
        are built on, before you read a single verdict.
      </p>
    </div>

    {/*
      A term-and-definition list, not the numbered `entries` layout. That layout
      sizes its first column at 3.2rem for a two-digit index; an evidence mark is
      a full label ("Official sources reviewed"), so it overflowed the column and
      printed on top of the heading beside it. It also duplicated itself, since
      the mark and the heading rendered the same string.
    */}
    <dl class="grades">
      {evidenceGrades.map((grade) => (
        <div class="grade">
          <dt><EvidenceMark grade={grade} /></dt>
          <dd>{getEvidenceMeaning(grade)}</dd>
        </div>
      ))}
    </dl>

    <div class="prose">
      <h2>What "hands-on" requires</h2>
      <p>
        We use the <strong>hands-on</strong> mark only where a real account was used, and the
        article says which parts of the product were exercised. Where an article is built on
        official documentation and verified public review consensus, it carries the
        <strong>official sources reviewed</strong> mark instead. Most of the library currently sits
        at official sources reviewed, and each article says so at the top.
      </p>

      <h2>What we score against</h2>
    </div>

    <ol class="entries">
      {criteria.map((item, index) => (
        <li class="entry">
          <span class="entry-index" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
          <div>
            <h3>{item.axis}</h3>
            <p>{item.detail}</p>
          </div>
        </li>
      ))}
    </ol>

    <div class="prose">
      <h2>Rules we hold ourselves to</h2>
    </div>
    <ul class="trust-list">
      {rules.map((rule) => (
        <li>{rule}</li>
      ))}
    </ul>

    <div class="prose">
      <h2>What we do not publish</h2>
      <p>
        No invented user counts, revenue figures, testimonials, or review histories. No AI-written
        claim of personal experience. No "sponsored" attribute on a link that is not an affiliate
        link, and no unlabeled affiliate link. Where a claim cannot be sourced, it does not go on
        the page.
      </p>

      <h2>Found something wrong?</h2>
      <p>
        Corrections are welcome and we would rather hear them than not. Write to
        <a href={`mailto:${operator.email}`}>{operator.email}</a> — see our
        <a href="/editorial-methodology/">editorial methodology</a> for how sources are weighted,
        and our <a href="/affiliate-disclosure/">affiliate disclosure</a> for who pays us.
      </p>
    </div>
  </section>
</BaseLayout>
