---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import EvidenceMark from "../components/EvidenceMark.astro";
import { categories, categoryPath } from "../lib/categories";
import { operator } from "../site";

const articles = (await getCollection("articles")).sort(
  (a, b) => b.data.updatedDate.valueOf() - a.data.updatedDate.valueOf()
);
const lastVerified = articles
  .map((article) => article.data.lastVerifiedDate)
  .sort()
  .at(-1);

const bySlug = new Map(articles.map((article) => [article.slug, article]));

// The entry route into the site, ordered by how a reader actually decides:
// what am I choosing between, then which one, then is it worth the money.
const startHere = [
  {
    slug: "best-email-marketing-tools-for-creators",
    context: "If you are still narrowing the field"
  },
  {
    slug: "kit-vs-beehiiv",
    context: "If it is down to the two most common choices"
  },
  {
    slug: "beehiiv-review",
    context: "If you want one platform examined in detail"
  }
]
  .map((item) => ({ ...item, article: bySlug.get(item.slug) }))
  .filter((item) => item.article !== undefined);

const primaryRead = bySlug.get("best-email-marketing-tools-for-creators") ?? articles[0];

// ---------------------------------------------------------------------------
// The hero's visual hook is the site's own coverage, rendered as an instrument
// rather than described in a sentence. Every figure below is counted from the
// article collection at build time, so it cannot drift from what we publish and
// nothing here is a hand-typed marketing number.
// ---------------------------------------------------------------------------
const productNames: Record<string, string> = {
  kit: "Kit",
  beehiiv: "beehiiv",
  activecampaign: "ActiveCampaign",
  hubspot: "HubSpot"
};

const coverageCount = new Map<string, number>();
for (const article of articles) {
  for (const product of article.data.products) {
    coverageCount.set(product, (coverageCount.get(product) ?? 0) + 1);
  }
}
const coverage = [...coverageCount.entries()]
  .map(([key, count]) => ({ key, name: productNames[key] ?? key, count }))
  .sort((a, b) => b.count - a.count);

// The headline matchup is a real article, not a constructed pairing: it appears
// only because kit-vs-beehiiv exists and covers exactly these two products.
const matchupArticle = bySlug.get("kit-vs-beehiiv");
const matchupPair = matchupArticle?.data.products.map((p) => productNames[p] ?? p) ?? [];
const matchupCovered = matchupArticle
  ? articles.filter((article) =>
      matchupArticle.data.products.every((product) => article.data.products.includes(product))
    ).length
  : 0;

const articleCountByCategory = new Map<string, number>();
for (const article of articles) {
  articleCountByCategory.set(
    article.data.category,
    (articleCountByCategory.get(article.data.category) ?? 0) + 1
  );
}

// The homepage shows the topics we actually publish in. Planned topics are
// named in one line underneath rather than given equal visual weight — four
// empty blocks reading "nothing published yet" would make an honest roadmap
// look like an empty site. The full list, with status, lives on /topics/.
const liveTopics = categories
  .map((category) => ({ ...category, count: articleCountByCategory.get(category.key) ?? 0 }))
  .filter((category) => category.count > 0);
const plannedTopics = categories.filter(
  (category) => (articleCountByCategory.get(category.key) ?? 0) === 0
);

// Why this site is different, stated as method rather than as a trust plea.
// Kept to three: a longer list reads as protesting too much.
const method = [
  {
    heading: "Verified, not repeated",
    body: "Pricing and plan limits come from the vendor's own pages and carry the date we last checked them."
  },
  {
    heading: "Evidence stated per article",
    body: "Each comparison says on the page what its claims are built on. We never imply hands-on use we have not had."
  },
  {
    heading: "Unknowns stay unknown",
    body: "What we have not checked is marked as such rather than filled in with a confident guess."
  }
];
---

<BaseLayout
  title="Which creator tool is worth paying for?"
  description="Independent comparisons of the software creators and one-person businesses actually pay for — checked against the vendors' own pricing, with the evidence behind every verdict stated on the page."
>
  <section class="stage">
    <div class="stage-field" aria-hidden="true"></div>
    <div class="stage-inner">
      <div class="stage-lede">
        <p class="stage-eyebrow">Independent &middot; Creator tool comparisons</p>
        <h1 class="stage-title">
          Which creator tool is <em>actually</em> worth paying for?
        </h1>
        <p class="stage-dek">
          Comparisons of the software creators and one-person businesses really pay for —
          checked against the vendors' own pricing, with the evidence behind every verdict
          stated on the page.
        </p>
        <div class="stage-actions">
          {primaryRead && (
            <a class="button button-lead" href={`/${primaryRead.slug}/`}>
              Start with the field guide
            </a>
          )}
          <a class="stage-secondary" href="/articles/">
            All {articles.length} comparisons
          </a>
        </div>
      </div>

      {matchupArticle && matchupPair.length === 2 && (
        <aside class="matchup" aria-label="Most-read comparison">
          <p class="matchup-kicker">The comparison most people arrive for</p>
          <a class="matchup-pair" href={`/${matchupArticle.slug}/`}>
            <span class="matchup-name">{matchupPair[0]}</span>
            <span class="matchup-versus" aria-hidden="true">vs</span>
            <span class="matchup-name">{matchupPair[1]}</span>
          </a>
          <dl class="matchup-meta">
            <div>
              <dt>Articles covering both</dt>
              <dd>{matchupCovered}</dd>
            </div>
            <div>
              <dt>Facts last verified</dt>
              <dd>{matchupArticle.data.lastVerifiedDate}</dd>
            </div>
          </dl>
          <div class="coverage">
            <p class="coverage-head">Tools covered so far</p>
            <ul>
              {coverage.map((item) => (
                <li>
                  <span class="coverage-count">{item.count}</span>
                  <span class="coverage-name">{item.name}</span>
                </li>
              ))}
            </ul>
          </div>
        </aside>
      )}
    </div>
  </section>

  <section class="band band-method" aria-label="How this site works">
    <div class="section-head">
      <h2>Why these comparisons are different</h2>
      <a href="/how-we-test/">Our review criteria</a>
    </div>
    <ul class="method">
      {method.map((item) => (
        <li>
          <h3>{item.heading}</h3>
          <p>{item.body}</p>
        </li>
      ))}
    </ul>
    {lastVerified && (
      <p class="method-stamp">
        <span>Most recent fact check</span>
        <strong>{lastVerified}</strong>
      </p>
    )}
  </section>

  <section class="band">
    <div class="section-head">
      <h2>Where to start</h2>
      <a href="/articles/">All articles</a>
    </div>
    <ol class="entries">
      {startHere.map((item, index) => (
        <li class="entry">
          <span class="entry-index" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
          <div>
            <p class="eyebrow">{item.context}</p>
            <h3><a href={`/${item.article!.slug}/`}>{item.article!.data.title}</a></h3>
            <p>{item.article!.data.description}</p>
            <p class="entry-meta">
              <EvidenceMark grade={item.article!.data.evidence} />
              <span>Updated {item.article!.data.updatedDate.toISOString().slice(0, 10)}</span>
            </p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section class="band">
    <div class="section-head">
      <h2>What we cover</h2>
      <a href="/topics/">All topics</a>
    </div>
    <ul class="topics">
      {liveTopics.map((topic) => (
        <li class="topic" data-state="live">
          <h3><a href={categoryPath(topic.key)}>{topic.name}</a></h3>
          <p>{topic.description}</p>
          <span class="topic-state">
            {topic.count} {topic.count === 1 ? "article" : "articles"}
          </span>
        </li>
      ))}
    </ul>
    {plannedTopics.length > 0 && (
      <p class="notice">
        Extending next into {plannedTopics.map((topic) => topic.name).join(", ")}.
        Nothing is published in those yet, and <a href="/topics/">topics</a> says so rather than
        filling them with thin pages.
      </p>
    )}
  </section>

  <section class="band band-quiet">
    <p class="colophon-line">
      Published by <a href={operator.url} rel="noopener">{operator.name}</a>, an independent
      one-person studio. Some outbound links are affiliate links, labelled where they appear and
      listed in full on <a href="/affiliate-disclosure/">affiliate disclosure</a>. Commission never
      decides a verdict. Questions and corrections:
      <a href={`mailto:${operator.email}`}>{operator.email}</a>.
    </p>
  </section>
</BaseLayout>
