---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ShioriGuide from "../components/ShioriGuide.astro";
import ArticleCard from "../components/ArticleCard.astro";
import { categoryPath } from "../lib/categories";
import { activeHeroMedia } from "../lib/heroMedia";
import { editorialCards } from "../lib/editorialMedia";
import "../styles/home.css";

// Rendered inside the hero's visual frame when an approved asset framed for it
// exists. Until then the frame is the static decision visual below
// (HERO_VIDEO_ASSET_REQUIRED; see src/lib/heroMedia.ts).
const heroMedia = activeHeroMedia("hero-visual");

const articles = await getCollection("articles");
const bySlug = new Map(articles.map((article) => [article.slug, article]));

// Reading time is derived from the article body at build time, never typed.
const readingMinutes = (body: string) =>
  Math.max(1, Math.round(body.split(/\s+/).filter(Boolean).length / 230));

// Only cards whose article exists are shown; a card cannot outlive its page.
const stories = editorialCards
  .map((card) => ({ card, article: bySlug.get(card.slug) }))
  .filter((item) => item.article !== undefined)
  .map(({ card, article }) => ({
    card,
    title: article!.data.title,
    updated: article!.data.updatedDate,
    minutes: readingMinutes(article!.body)
  }));

// Every decision card points at a page that exists today. A decision with no
// dedicated guide goes to the nearest real one, and the mapping is stated here
// so it can be reviewed: "Grow on YouTube" lands on the ElevenLabs guide
// because it is the page that covers monetized YouTube Shorts.
const decisions = [
  { key: "start", label: "Start a newsletter", hint: "Pick your first platform", href: "/best-newsletter-platforms/", accent: "mint" },
  { key: "leave", label: "Leave beehiiv", hint: "Alternatives by reason", href: "/beehiiv-alternatives/", accent: "cyan" },
  { key: "compare", label: "Compare two platforms", hint: "Kit vs beehiiv, head to head", href: "/kit-vs-beehiiv/", accent: "mint" },
  { key: "voice", label: "Add AI voice", hint: "AI voice guides", href: categoryPath("ai-voice"), accent: "pink" },
  { key: "youtube", label: "Grow on YouTube", hint: "Narration for Shorts", href: "/elevenlabs-for-short-form-video/", accent: "cyan" }
].filter((item) => item.href.startsWith("/topics/") || bySlug.has(item.href.replace(/\//g, "")));

const method = [
  { step: "01", title: "Start with the workflow.", body: "What you publish, how often, and what you need the tool to do." },
  { step: "02", title: "Identify the tradeoffs.", body: "Price, ownership, and effort move together. We name which one you give up." },
  { step: "03", title: "Verify material facts.", body: "Pricing and plan limits are checked against the vendor's own pages and dated." },
  { step: "04", title: "Show where each option fits.", body: "A clear rule for who each tool suits, including tools we earn nothing from." }
];
---

<BaseLayout
  title="Find the tool that fits how you actually work"
  description="Independent decision guides for newsletter, audience growth, AI voice, and creator workflows. Choose by fit, not hype."
>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-inner">
      <div class="hero-copy">
        <p class="kicker">Independent guides for creators</p>
        <h1 id="hero-title" class="hero-title">
          Find the tool that fits how you <span class="hero-em">actually</span> work.
        </h1>
        <p class="hero-dek">
          Independent decision guides for newsletter, audience growth, AI voice, and creator
          workflows.
        </p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="#decide">Find my fit</a>
          <a class="btn btn-quiet" href="/articles/">Browse comparisons</a>
        </div>
        <ul class="hero-points">
          <li>Independent research</li>
          <li>Practical decision guides</li>
          <li>Built for real creators</li>
        </ul>
      </div>

      <div
        class="hero-visual"
        data-media={heroMedia ? "true" : "false"}
        style={heroMedia ? `--hero-poster: url("${heroMedia.poster}")` : undefined}
      >
        {heroMedia && (
          <video
            class="stage-media"
            src={heroMedia.src}
            poster={heroMedia.poster}
            width={heroMedia.width}
            height={heroMedia.height}
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
            aria-hidden="true"
            tabindex="-1"
          />
        )}
        <div class="hv-scene" aria-hidden="true">
          <ul class="hv-noise">
            <li style="--i:0">Newsletter?</li>
            <li style="--i:1">AI voice?</li>
            <li style="--i:2">Automation?</li>
            <li style="--i:3">Analytics?</li>
            <li style="--i:4">Which is better?</li>
          </ul>
          <div class="hv-panel">
            <p class="hv-panel-head"><span class="hv-dot"></span>Your decision</p>
            <ol class="hv-list">
              <li>Right tool for your goals</li>
              <li>Side-by-side comparisons</li>
              <li>Real creator use cases</li>
              <li>Honest pros and cons</li>
            </ol>
            <span class="hv-panel-foot"></span>
          </div>
        </div>
        <ShioriGuide message="Start here." class="hero-shiori" />
      </div>
    </div>
    <p class="hero-line"><span>Choose by fit, not hype.</span></p>
  </section>

  <section class="section" id="decide" aria-labelledby="decide-title">
    <div class="section-inner">
      <p class="kicker">Start with a question</p>
      <h2 id="decide-title" class="section-title">What are you trying to decide?</h2>
      <ul class="decisions">
        {decisions.map((item) => (
          <li>
            <a class="decision" href={item.href} data-accent={item.accent}>
              <span class="decision-icon" aria-hidden="true">
                {item.key === "start" && (
                  <svg viewBox="0 0 24 24"><path d="M4 6.5h16v11H4z" /><path d="m4 7 8 6 8-6" /></svg>
                )}
                {item.key === "leave" && (
                  <svg viewBox="0 0 24 24"><path d="M14 5h5v14h-5" /><path d="M4 12h10" /><path d="m10 8 4 4-4 4" /></svg>
                )}
                {item.key === "compare" && (
                  <svg viewBox="0 0 24 24"><path d="M4 5h6v14H4zM14 5h6v14h-6z" /></svg>
                )}
                {item.key === "voice" && (
                  <svg viewBox="0 0 24 24"><path d="M5 10v4M9 7v10M13 4v16M17 8v8M21 11v2" /></svg>
                )}
                {item.key === "youtube" && (
                  <svg viewBox="0 0 24 24"><path d="M3 7.5a2.5 2.5 0 0 1 2.5-2.5h13A2.5 2.5 0 0 1 21 7.5v9a2.5 2.5 0 0 1-2.5 2.5h-13A2.5 2.5 0 0 1 3 16.5z" /><path d="m10 9 5 3-5 3z" /></svg>
                )}
              </span>
              <span class="decision-text">
                <span class="decision-label">{item.label}</span>
                <span class="decision-hint">{item.hint}</span>
              </span>
              <span class="decision-arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="now-title">
    <div class="section-inner">
      <div class="section-row">
        <div>
          <p class="kicker">Decision guides</p>
          <h2 id="now-title" class="section-title">Decisions creators are making now</h2>
        </div>
        <a class="text-link" href="/articles/">All {articles.length} guides →</a>
      </div>
      <div class="stories">
        {stories.map((story) => (
          <ArticleCard
            card={story.card}
            title={story.title}
            updated={story.updated}
            readingMinutes={story.minutes}
          />
        ))}
      </div>
    </div>
  </section>

  <section class="section section-method" aria-labelledby="method-title">
    <div class="section-inner method-grid">
      <div class="method-lede">
        <p class="kicker">How we review</p>
        <h2 id="method-title" class="section-title">
          We compare tools around decisions, not feature counts.
        </h2>
        <a class="text-link" href="/editorial-methodology/">See our methodology →</a>
      </div>
      <ol class="steps">
        {method.map((item) => (
          <li>
            <span class="step-num" aria-hidden="true">{item.step}</span>
            <div>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <aside class="section disclosure-strip" aria-label="How we make money">
    <div class="section-inner disclosure-inner">
      <p>
        Some links on this site are affiliate links. We may earn a commission if you purchase
        through them, at no extra cost to you. This does not determine which tools we cover or
        recommend.
      </p>
      <a class="text-link" href="/affiliate-disclosure/">How we make money →</a>
    </div>
  </aside>
</BaseLayout>
