---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const articles = (await getCollection("articles")).sort(
  (a, b) => b.data.updatedDate.valueOf() - a.data.updatedDate.valueOf()
);
const lastVerified = articles
  .map((article) => article.data.lastVerifiedDate)
  .sort()
  .at(-1);

const bySlug = new Map(articles.map((article) => [article.slug, article]));
const useCases = [
  {
    heading: "You sell courses, coaching, or digital products",
    body: "You need forms, tagging, and simple automated sequences that turn subscribers into buyers.",
    slug: "best-email-marketing-tools-for-creators",
    linkText: "Compare creator email tools"
  },
  {
    heading: "The newsletter itself is the business",
    body: "You care about publication growth, recommendations, sponsorships, and paid subscriptions.",
    slug: "beehiiv-alternatives",
    linkText: "Compare newsletter platforms"
  },
  {
    heading: "You run a one-person business",
    body: "You want the smallest tool that removes real work, without paying for automation you will not use.",
    slug: "best-email-marketing-for-solopreneurs",
    linkText: "Compare solopreneur tools"
  }
].filter((useCase) => bySlug.has(useCase.slug));

const evidenceBar = [
  { value: String(articles.length), label: "Published comparisons" },
  { value: "Checked", label: "Official vendor sources", href: "/editorial-methodology/" },
  { value: "Disclosed", label: "Affiliate relationships", href: "/affiliate-disclosure/" },
  ...(lastVerified ? [{ value: lastVerified, label: "Last verified" }] : [])
];

const differentiators = [
  "We do not invent hands-on experience we haven't had.",
  "Affiliate commission does not decide the verdict.",
  "Unsupported claims get corrected, not buried.",
  "Prices and features carry a verification date.",
  "What we haven't checked, we mark unknown, not assumed."
];
---

<BaseLayout
  title="Newsletter and Email Tool Comparisons for Creators"
  description="Research-backed comparisons of newsletter and email marketing tools for creators, solopreneurs, and small online businesses."
>
  <div class="hero-wrap">
    <section class="hero">
      <div>
        <p class="eyebrow">Independent, evidence-first comparisons</p>
        <h1>Newsletter software, checked against the evidence.</h1>
        <p class="dek">
          Practical comparisons for creators and small online businesses choosing email marketing software, with
          verified pricing, disclosed affiliate relationships, and no invented hands-on claims.
        </p>
      </div>
      <aside class="hero-panel">
        <h2>Start here</h2>
        <p>
          Most creators are choosing between a creator-funnel tool and a newsletter-growth platform. Start with the
          full comparison, then narrow by how you actually make money.
        </p>
        <a class="button" href="/best-email-marketing-tools-for-creators/">Read the main comparison</a>
      </aside>
    </section>
  </div>

  <section class="evidence-bar" aria-label="Evidence and verification status">
    <ul class="evidence-bar-list">
      {evidenceBar.map((item) => (
        <li>
          {item.href ? (
            <a href={item.href}>
              <span class="evidence-value">{item.value}</span>
              <span class="evidence-label">{item.label}</span>
            </a>
          ) : (
            <>
              <span class="evidence-value">{item.value}</span>
              <span class="evidence-label">{item.label}</span>
            </>
          )}
        </li>
      ))}
    </ul>
  </section>

  <section class="band">
    <h2>Start with your situation</h2>
    <div class="tool-grid">
      {useCases.map((useCase) => (
        <article class="card use-case">
          <h3>{useCase.heading}</h3>
          <p>{useCase.body}</p>
          <a href={`/${useCase.slug}/`}>{useCase.linkText}</a>
        </article>
      ))}
    </div>
  </section>

  <section class="band">
    <div class="band-head">
      <h2>Latest comparisons</h2>
      <a href="/articles/">All articles</a>
    </div>
    <div class="cards">
      {articles.slice(0, 3).map((article) => (
        <article class="card article-card">
          <h3><a href={`/${article.slug}/`}>{article.data.title}</a></h3>
          <p>{article.data.description}</p>
          <p class="article-meta">
            <span>Updated {article.data.updatedDate.toISOString().slice(0, 10)}</span>
          </p>
        </article>
      ))}
    </div>
  </section>

  <section class="band differentiators">
    <h2>How we're different</h2>
    <ul class="trust-list diff-list">
      {differentiators.map((item) => (
        <li>{item}</li>
      ))}
    </ul>
    <p class="notice">
      Some links on this site are affiliate links and are labelled as such on the page. Others go straight to a
      product's own website and earn us nothing. Read our
      <a href="/affiliate-disclosure/">affiliate disclosure</a> and
      <a href="/editorial-methodology/">editorial methodology</a>.
    </p>
  </section>
</BaseLayout>
